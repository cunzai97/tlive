# TLive Configuration
# Reference for ~/.tlive/server.env and ~/.tlive/client.env.
# Runtime reads role-specific files only.
# Existing ~/.tlive/config.env is auto-split if either role file is missing.
# chmod 600 ~/.tlive/*.env

# ~/.tlive/server.env on the Feishu bot machine:
TL_TOKEN=your-token-here

# Feishu
TL_FS_APP_ID=
TL_FS_APP_SECRET=
TL_FS_ALLOWED_USERS=
TL_FS_VERIFICATION_TOKEN=
TL_FS_ENCRYPT_KEY=
# Pin newly-created Feishu topic entry messages to the chat Pin list.
# Set to false to disable.
TL_FS_AUTO_PIN_TOPIC=true

# Block-based tool flow. Set legacy to roll back presentation without reverting code.
# Native CardKit printing for active thoughts/replies; requires cardkit:card:write.
# Set false for lossless ordinary-card patch fallback.
TL_FS_NATIVE_STREAMING=true
TL_FS_CARD_FLOW=blocks
# Short thinking/replies between tools do not split a same-category group.
# Provider-neutral token estimates are used unless an exact counter is injected.
TL_FS_TOOL_GROUP_GAP_TOKENS=50
# Serialized UTF-8 budget and recursive component budget, with platform headroom.
TL_FS_CARD_MAX_BYTES=24000
TL_FS_CARD_MAX_ELEMENTS=160
# Optional tool-name overrides; preserve the provider's actual tool names.
# Values: exploration, execution, edit, generic.
# TL_FS_TOOL_DISPLAY_RULES={"read":"exploration","grab":"exploration","bash":"execution","write":"edit","replace":"edit"}

# Buttons shown after a task completes.
# Supported: home,new,help,perm,none
TL_DONE_BUTTONS=home

# HTTP MCP endpoint for agent callbacks (enabled by default)
# TL_MCP_ENABLED=true
# TL_MCP_PORT=8081
# TL_MCP_PATH=/mcp
# TL_MCP_TOKEN=
# TL_MCP_MAX_FILE_MB=20

# TL_REMOTE_SERVER_PORT=8787
# TL_REMOTE_SERVER_PATH=/tlive
# TL_REMOTE_TOKEN=change-this-token
#
# ~/.tlive/client.env on worker machines:
# TL_REMOTE_SERVER_URL=ws://your-server:8787/tlive
# TL_REMOTE_TOKEN=change-this-token
# TL_PROVIDER=claude
# TL_DEFAULT_MODEL=
# TL_REMOTE_CLIENT_ID=
# TL_REMOTE_CLIENT_NAME=
# TL_REMOTE_CLIENT_NOTE=
# TL_DEFAULT_WORKDIR=/path/to/default/project
# Optional quick directories shown in /home. They do not limit /cd.
# TL_REMOTE_WORKSPACES=/path/to/project-a,/path/to/project-b
#
# Agent provider settings sources (comma-separated)
#   user    — ~/.claude/settings.json (auth, API key, model overrides)
#   project — .claude/settings.json + CLAUDE.md + project MCP config
#   local   — .claude/settings.local.json (developer overrides)
# TL_AGENT_SETTINGS=user,project,local
#
# Codex provider options
# TL_CODEX_MODEL=
# TL_CODEX_PATH=
# auto probes workspace-write support and falls back with a warning on known bwrap permission errors.
# Set workspace-write explicitly to forbid that fallback, or danger-full-access to disable sandboxing.
# TL_CODEX_SANDBOX_MODE=auto
# TL_CODEX_APPROVAL_POLICY=on-request
# TL_CODEX_SKIP_GIT_REPO_CHECK=false
# TL_CODEX_REASONING_EFFORT=
# TL_CODEX_NETWORK_ACCESS=
# TL_CODEX_WEB_SEARCH=
#
# Pi provider options
# TL_PI_AGENT_DIR=
# TL_PI_SESSION_DIR=
# TL_PI_PROVIDER=
# TL_PI_MODEL=
# TL_PI_THINKING=
# TL_PI_NO_SESSION=false
# TL_PI_OFFLINE=false
# Share of the model context window to keep free, so Pi compacts earlier than its
# own (contextWindow - reserveTokens) line. Default 20; 0 defers to
# ~/.pi/agent/settings.json. Never lowers a reserve that file already asks for.
# TL_PI_COMPACT_RESERVE_PERCENT=20
#
# Provider API keys (optional; set here or as shell env vars)
# Non-TL_ vars in client.env are injected into process.env at startup.
# ANTHROPIC_API_KEY=sk-ant-...
# CODEX_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
